# Google Maps for the campus map. Without a key the app shows its own offline campus view.
# A free "Maps Demo Key" works (personal Gmail account, no billing): search "Maps Demo Key".
VITE_GOOGLE_MAPS_KEY=
# Optional: a Map ID from Google Cloud with your own dark map style (pure black land, etc.).
# Leave empty to use DEMO_MAP_ID with Google's dark colour scheme.
VITE_GOOGLE_MAP_ID=
